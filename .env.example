# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# At least one LLM key is required. Gemini is the primary; Groq and Hugging Face are fallbacks.
GEMINI_API_KEY=
GROQ_API_KEY=
HF_TOKEN=

# Optional: model fallback order, "provider:model" separated by commas.
# Model IDs get retired and shutdown dates move, so run
#   python scripts/check_providers.py
# and edit this list if a model reports as unavailable.
# LLM_CHAIN=gemini:gemini-3.5-flash,gemini:gemini-3.1-flash-lite,groq:openai/gpt-oss-120b,huggingface:meta-llama/Llama-3.3-70B-Instruct
# ASR_MODELS=whisper-large-v3-turbo,whisper-large-v3
# GEMINI_ASR_MODEL=gemini-3.5-flash

# Optional limits
# MAX_TRANSCRIPT_CHARS=150000
# MAX_AUDIO_MB=60
# MAX_AUDIO_MINUTES=90
# RATE_LIMIT_PER_MINUTE=20
# AUDIO_JOBS_PER_10_MIN=3
